# The comps paper. Adapted from the Oxy CS comps paper template's Makefile
# (https://github.com/justinnhli/oxy-cs-comps-paper-template).
#
# numbers.tex is generated by scripts/paper_numbers.py from the study data, which is not in the
# repository, so it is committed and this Makefile does not rebuild it. To regenerate it, from the
# repository root:  uv run python scripts/paper_numbers.py

LATEX = latexmk -pdf --shell-escape

default: main.pdf

main.pdf: Makefile main.tex numbers.tex references.bib oxycomps.sty
	$(LATEX) main

clean:
	latexmk -C main
	rm -f *-blx.bib *.bbl *.run.xml
