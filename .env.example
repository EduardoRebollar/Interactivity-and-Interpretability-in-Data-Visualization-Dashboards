# Copy to .env.local and fill in. .env and .env.* are gitignored — this repo is public, so the real
# connection string must never be committed.
#
# Get this by provisioning Neon through the Vercel Marketplace, then:
#   vercel env pull .env.local
#
# Use Neon's POOLED connection string (the host contains "-pooler"). Serverless functions open and
# drop connections constantly; the pooled endpoint absorbs that churn, the direct one exhausts.
#
# Keep the `sslmode=require` Neon puts on the string: the IRB forms tell participants their data is
# encrypted on its way to the database.
DATABASE_URL=

# Optional. Any non-empty value turns on the Dash debug server locally. Never set in production.
DASH_DEBUG=

# Optional. The researcher's countersignature on the consent screen: a data:image/png;base64,...
# URI of the signature on a transparent ground. Kept out of git because this repo is public. Set it
# in Vercel's environment variables and in .env.local. Unset, the countersignature line is blank.
RESEARCHER_SIGNATURE=
