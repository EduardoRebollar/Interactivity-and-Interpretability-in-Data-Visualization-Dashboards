# Environment
.venv/
__pycache__/
*.py[cod]

# Secrets. DATABASE_URL must never reach this public repo.
.env
.env.*
!.env.example

# Vercel
.vercel/

# Tooling caches
.pytest_cache/
.ruff_cache/

# IRB paperwork — local reference only. It will carry names, contact details and the institution's
# form, none of which belong in a public repo.
irb/

# Data — never committed. download_data.py refetches raw from OWID;
# processed/ is derived cache; study_logs/ is participant data.
data/raw/*
data/processed/*
data/study_logs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/study_logs/.gitkeep

# Signed consent records from local runs: names and signatures. Never committed (IRB form item 15).
data/consent/

# Belt and braces for participant data. The entries above already cover these, but a spool file or a
# coding sheet (participant-written free text) reaching this public repo is not a mistake to leave
# to one pattern. Analysis outputs are written under data/study_logs/ for the same reason.
data/study_logs/**
!data/study_logs/.gitkeep
*.spool.jsonl
*.recovered.jsonl
